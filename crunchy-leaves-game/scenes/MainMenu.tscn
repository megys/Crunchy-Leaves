[node name="AnimationPlayer" type="AnimationPlayer" parent="."]
libraries = {
"": SubResource("AnimationLibrary_8cb12")
}

[node name="Page Turn" type="AudioStreamPlayer" parent="AnimationPlayer"]
stream = ExtResource("16_vnsbn")
volume_db = -15.0

[node name="Music" type="AudioStreamPlayer" parent="."]
stream = ExtResource("15_pp3hh")
autoplay = true
bus = &"Music"

[connection signal="pressed" from="File/Card/Title Card/VBoxContainer/Play" to="." method="_on_play_pressed"]
[connection signal="pressed" from="File/Card/Title Card/VBoxContainer/HBoxContainer/Settings" to="." method="_on_settings_pressed"]
[connection signal="pressed" from="File/Card/Title Card/VBoxContainer/HBoxContainer/Controls" to="." method="_on_controls_pressed"]
[connection signal="pressed" from="File/Card/Title Card/VBoxContainer/HBoxContainer/Credits" to="." method="_on_credits_pressed"]
[connection signal="pressed" from="File/Card/Title Card/VBoxContainer/Free Play" to="." method="_on_free_play_pressed"]
[connection signal="pressed" from="Back" to="." method="_on_back_pressed"]
[connection signal="value_changed" from="Settings/VBoxContainer/Master/Master Slider" to="." method="_on_master_slider_value_changed"]
[connection signal="value_changed" from="Settings/VBoxContainer/Music/Music Slider" to="." method="_on_music_slider_value_changed"]
[connection signal="value_changed" from="Settings/VBoxContainer/SFX/SFX Slider" to="." method="_on_sfx_slider_value_changed"]
